public class MyFifthApp {

    public static void printChar(char ch, int repeatCount, int lineCount) {
        for (int i = 0; i < lineCount; i++) {
            for (int j = 0; j < repeatCount; j++) {
                System.out.print(ch);
            }
            System.out.println();
        }
    }

    public static void main(String[] args) {
        printChar('*', 5, 3);
    }
}